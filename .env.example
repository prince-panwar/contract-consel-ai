# ContractConsel configuration. Copy to `.env` (Docker Compose) or `.env.local`
# (npm run dev) and fill in. Never commit real values.

# ---- Public hostname (Caddy obtains the TLS certificate for it)
APP_DOMAIN=app.example.com

# ---- Database: MongoDB Atlas or any MongoDB 6+ URI
MONGODB_URI=
MONGODB_DB=contract_counsel

# ---- Embedding / PDF service (services/embed-server)
# Docker Compose sets EMBED_SERVICE_URL to the internal service automatically.
EMBED_SERVICE_URL=http://localhost:8080
# Must equal API_KEY in services/embed-server/.env.  openssl rand -hex 32
EMBED_SERVICE_API_KEY=

# ---- LLM (switch providers with env only)
#   anthropic  default model claude-haiku-5-5
#   gemini     default model gemini-2.5-flash
#   openai     any OpenAI-compatible API (OpenAI, DeepSeek, Groq, OpenRouter,
#              llama.cpp, vLLM…): set LLM_BASE_URL and LLM_MODEL
#   ollama     local Ollama; no key; default http://localhost:11434/v1
LLM_PROVIDER=anthropic
LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=

# ---- Security & privacy
# Signs session cookies; 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# AES-256-GCM key for contract data at rest (32 bytes, base64). Keep a copy in a
# password manager: losing it makes stored contracts unreadable.
# Must also be set in services/embed-server/.env.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONTENT_ENCRYPTION_KEY=
# Mask emails, phones, PAN/Aadhaar/GSTIN/IFSC, bank & card numbers before LLM calls.
PRIVACY_MASK_PII=true
# Every account must enrol an authenticator app before using the app.
REQUIRE_2FA=true

# ---- First administrator (used once, when no users exist yet)
# Generate the hash with: npm run hash-password '<password>'
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
