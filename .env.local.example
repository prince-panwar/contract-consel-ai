# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — override the Gemini model used for extraction.
# Good options: gemini-2.5-flash (default), gemini-2.5-flash-lite (cheaper/faster)
# GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas connection string (or any MongoDB URI).
# Example: mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name. Created automatically on first write.
MONGODB_DB=contract_counsel

# Admin credentials. Single admin only.
# Generate the hash with: npm run hash-password '<your-password>'
# The script prints a base64-encoded value to avoid Next.js env-loader
# expansion eating the `$` characters in raw bcrypt hashes.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Random 32+ character string used to sign the auth JWT.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
