# Listen port. In the root docker-compose stack the service is internal only.
PORT=8080

# Shared secret required in `x-api-key` header on every request.
# Generate with: openssl rand -hex 32
API_KEY=replace-me


# Cap concurrent requests. 2 is fine on Ampere A1 (4 OCPU / 24 GB).
# Drop to 1 on the old E2.1.Micro to avoid CPU contention.
MAX_CONCURRENCY=2

# MongoDB connection (required for /process-report). Must match the app's values.
MONGODB_URI=
MONGODB_DB=

# Max body size for /parse-pdf. Keep in sync with ragConfig.maxPdfBytes in the app.
MAX_UPLOAD_BYTES=41943040

# Texts per ONNX inference call inside the embed server. Each item adds ~30 MB
# transient RAM during the forward pass. Ampere A1 (24 GB): 64. Local 32 GB
# box: 128-256. Old 1 GB micro: 8.
INTERNAL_BATCH=64

# Parallel shards used by /process-report. Roughly one shard per CPU core.
# Ampere A1 (4 OCPU): 4. Local 8-core: 8.
FANOUT=4

# Same AES-256-GCM key as the app's CONTENT_ENCRYPTION_KEY: the embed server
# decrypts uploaded PDFs and writes page/passage text encrypted.
CONTENT_ENCRYPTION_KEY=
