# Listen port. Re-using the Oracle VCN ingress rule that was already
# open for the old mail-automation service, so we don't need to add a
# new firewall hole.
PORT=3000

# Shared secret required in `x-api-key` header on every request.
# Generate with: openssl rand -hex 32
API_KEY=8457273257214934670d9b7eae0eb84cf19cb533be6b77265f288fe1efa238bd


# Cap concurrent requests. 2 is fine on Ampere A1 (4 OCPU / 24 GB).
# Drop to 1 on the old E2.1.Micro to avoid CPU contention.
MAX_CONCURRENCY=2

# MongoDB Atlas connection (required for /process-report). Must match the
# values used by the Vercel side.
MONGODB_URI=
MONGODB_DB=

# Max body size for /parse-pdf. Keep in sync with ragConfig.maxPdfBytes on Vercel.
MAX_UPLOAD_BYTES=41943040

# Texts per ONNX inference call inside the embed server. Each item adds ~30 MB
# transient RAM during the forward pass. Ampere A1 (24 GB): 64. Local 32 GB
# box: 128-256. Old 1 GB micro: 8.
INTERNAL_BATCH=64

# Parallel shards used by /process-report. Roughly one shard per CPU core.
# Ampere A1 (4 OCPU): 4. Local 8-core: 8.
FANOUT=4
